{
  "name": "copyboard-lite-web",
  "private": true,
  "version": "0.1.2",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "check": "calcit calcit.cirru --check-only --all-defs && calcit calcit.cirru fix --workflow strict --verify",
    "compile": "calcit calcit.cirru",
    "dev": "yarn compile && vite --host 127.0.0.1",
    "build": "yarn compile && vite build"
  },
  "devDependencies": {
    "@calcit/procs": "0.30.1-alpha.5",
    "vite": "8.3.1"
  }
}
